# Cartsy Environment Variables Example
# Copy this file to .env.local and fill in your actual values
#
# Note: Node.js is required to run the Next.js frontend application.
# All backend services (database, auth, storage) are provided by Supabase.

# ============================================
# APPLICATION CONFIGURATION
# ============================================
NEXT_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# ============================================
# SUPABASE BACKEND CONFIGURATION
# ============================================
# Supabase provides complete backend services:
# - PostgreSQL Database
# - Authentication (email/password, OAuth)
# - File Storage
# - Real-time subscriptions
# - Edge functions
#
# Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# ============================================
# NEXTAUTH.JS CONFIGURATION
# ============================================
# NextAuth.js integrates with Supabase Auth for enhanced authentication
# Generate a secure random string for this
NEXTAUTH_SECRET="generate-a-secure-random-string-here"
NEXTAUTH_URL="http://localhost:3000"

# ============================================
# STRIPE PAYMENT CONFIGURATION
# ============================================
# Get these from your Stripe dashboard
# Use test keys for development
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key_here"
STRIPE_SECRET_KEY="sk_test_your_secret_key_here"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret_here"

# ============================================
# GOOGLE OAUTH CONFIGURATION
# ============================================
# Configure in Supabase Auth dashboard, then add keys here
# Get these from Google Cloud Console
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ============================================
# OPTIONAL SERVICES
# ============================================

# Google Maps API (for location features)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Email Service (for transactional emails)
# Uncomment and configure if using an email service
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@example.com"
# SMTP_PASSWORD="your-email-password"
# SMTP_FROM="noreply@cartsy.com"

# Analytics (optional)
# NEXT_PUBLIC_GA_ID="your-google-analytics-id"

# ============================================
# DEVELOPMENT SETTINGS
# ============================================
NODE_ENV="development"

# ============================================
# PRODUCTION SETTINGS
# ============================================
# When deploying to production, update these:
# NEXT_URL="https://your-domain.com"
# NEXTAUTH_URL="https://your-domain.com"
# NEXT_PUBLIC_API_URL="https://your-domain.com/api"
# NODE_ENV="production"
